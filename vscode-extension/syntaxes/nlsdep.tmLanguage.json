{
  "name": "NLS Dependency Hover",
  "scopeName": "source.nlsdep",
  "patterns": [
    {
      "match": "^(head)\\s+(\\S+)\\s+(\\S+)\\s*(\\{)?",
      "captures": {
        "1": { "name": "storage.type.nlsdep" },
        "2": { "name": "entity.name.type.nlsdep" },
        "3": { "name": "storage.type.nlsdep" },
        "4": { "name": "punctuation.definition.block.begin.nlsdep" }
      }
    },
    {
      "match": "^\\s+(\\S+)\\s+(\\S+)",
      "captures": {
        "1": { "name": "variable.other.member.nlsdep" },
        "2": { "name": "support.type.nlsdep" }
      }
    },
    {
      "match": "^\\}",
      "name": "punctuation.definition.block.end.nlsdep"
    }
  ]
}
